# Copy to `.env` and fill in. NEVER commit the real .env. These stay server-side
# in the Rust backend — they must never be exposed to the browser.

# PostgreSQL
DATABASE_URL=postgres://localhost/sankayi

# Instagram / Meta Graph API (Phase 2)
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Meta Ads / Marketing API (Phase 3)
META_AD_ACCOUNT_ID=

# Quicket REST API — LIVE. Copy this file to backend/.env and fill in.
QUICKET_API_KEY=            # subscriber key from developer.quicket.co.za
QUICKET_USER_TOKEN=         # usertoken from the organiser's Quicket account (grants private data)
# Optional ingestion tuning:
QUICKET_ORGANISER_ID=91748  # only ingest this organiser's events; 'all' to disable the filter
QUICKET_EVENT_IDS=          # comma-separated event IDs to force-include (orders discovery may miss some)
QUICKET_DEFAULT_CAPACITY=220 # venue capacity used for sell-through when Quicket doesn't expose it

# Yoco — LIVE door sales (in-person card-machine ticket sales via the Orders API).
YOCO_API_KEY=                        # API key from developer.yoco.com/ui, scope business/orders:read
# Optional ingestion tuning:
YOCO_TICKET_PRODUCT=Sankayi Jazz Series  # Yoco product name that marks a door ticket (case-insensitive contains-match)
YOCO_START_DATE=                     # earliest date to sync from (YYYY-MM-DD); defaults to the first event

# Server
BIND_ADDR=127.0.0.1:8080
